<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep the Strava client secret / OAuth tokens (stored in the user_prefs DataStore)
             off the device: don't include them in cloud backup or device transfer. -->
        <exclude domain="file" path="datastore/user_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/user_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
