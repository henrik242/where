default_platform(:ios)

TEAM_ID = "358L7UXVJ4"
APP_IDENTIFIER = "no.synth.where"

platform :android do
  lane :deploy do
    submit = ENV["SUBMIT_FOR_REVIEW"] != "false"
    upload_to_play_store(
      package_name: APP_IDENTIFIER,
      track: "production",
      release_status: submit ? "completed" : "draft",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      mapping: "app/build/outputs/mapping/release/mapping.txt",
      json_key: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH"],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  lane :build do
    setup_ci if ENV["CI"]

    cert_path = ENV["DISTRIBUTION_CERTIFICATE_PATH"]
    if cert_path
      import_certificate(
        certificate_path: cert_path,
        certificate_password: ENV["DISTRIBUTION_CERTIFICATE_PASSWORD"],
        certificate_format: "pkcs12",
        keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "login",
        keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || "",
        log_output: true
      )
    end

    profile_path = ENV["PROVISIONING_PROFILE_PATH"]
    install_provisioning_profile(path: profile_path) if profile_path

    profile_name = ENV["PROFILE_NAME"] || ""

    # Manual signing is passed on the xcodebuild command line, which outranks the project
    # file, so the checked-in Automatic signing config is left untouched.
    signing_args = profile_name.empty? ? nil : {
      "CODE_SIGN_STYLE" => "Manual",
      "DEVELOPMENT_TEAM" => TEAM_ID,
      "CODE_SIGN_IDENTITY" => "iPhone Distribution",
      "PROVISIONING_PROFILE_SPECIFIER" => profile_name
    }

    build_app(
      project: "iosApp/Where.xcodeproj",
      scheme: "Where",
      configuration: "Release",
      export_method: "app-store",
      output_directory: ENV["OUTPUT_DIR"] || "./build",
      output_name: "Where.ipa",
      destination: "generic/platform=iOS",
      skip_profile_detection: true,
      xcargs: signing_args,
      export_options: {
        method: "app-store",
        teamID: TEAM_ID,
        signingStyle: "manual",
        signingCertificate: "iPhone Distribution",
        uploadSymbols: true,
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )
  end

  lane :deploy do
    submit = ENV["SUBMIT_FOR_REVIEW"] != "false"
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )
    whats_new_en = ENV["WHATS_NEW_EN"] || "Bug fixes and improvements."
    whats_new_no = ENV["WHATS_NEW_NO"] || "Feilrettinger og forbedringer."
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: ENV["IPA_PATH"],
      skip_screenshots: true,
      skip_metadata: !submit,
      force: true,
      submit_for_review: submit,
      automatic_release: submit,
      precheck_include_in_app_purchases: false,
      release_notes: { "en-US" => whats_new_en, "no" => whats_new_no }
    )
  end
end
