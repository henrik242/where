default_platform(:ios)

TEAM_ID = "358L7UXVJ4"
APP_IDENTIFIER = "no.synth.where"
SCHEME = "Where"

platform :android do
  lane :deploy do
    submit = ENV["SUBMIT_FOR_REVIEW"] != "false"
    upload_to_play_store(
      package_name: APP_IDENTIFIER,
      track: "production",
      release_status: submit ? "completed" : "draft",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      mapping: "app/build/outputs/mapping/release/mapping.txt",
      json_key: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH"],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  lane :build do
    setup_ci if ENV["CI"]

    cert_path = ENV["DISTRIBUTION_CERTIFICATE_PATH"]
    if cert_path
      import_certificate(
        certificate_path: cert_path,
        certificate_password: ENV["DISTRIBUTION_CERTIFICATE_PASSWORD"],
        certificate_format: "pkcs12",
        keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "login",
        keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || "",
        log_output: true
      )
    end

    profile_path = ENV["PROVISIONING_PROFILE_PATH"]
    install_provisioning_profile(path: profile_path) if profile_path

    profile_name = ENV["PROFILE_NAME"] || ""

    # Switch the app target to manual signing. This has to be per-target: passing
    # PROVISIONING_PROFILE_SPECIFIER on the xcodebuild command line hits the SPM package
    # targets too, and Xcode fails the archive on targets that cannot take a profile.
    unless profile_name.empty?
      update_code_signing_settings(
        path: "iosApp/Where.xcodeproj",
        targets: [SCHEME],
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "iPhone Distribution",
        profile_name: profile_name
      )
    end

    # Pin derived data so we know where SPM checks out firebase-ios-sdk; upload-symbols
    # lives inside that checkout and Crashlytics dSYM upload below needs its path.
    derived_data = File.expand_path(ENV["DERIVED_DATA_PATH"] || "build/ios-derived-data")

    build_app(
      project: "iosApp/Where.xcodeproj",
      scheme: SCHEME,
      configuration: "Release",
      derived_data_path: derived_data,
      export_method: "app-store",
      output_directory: ENV["OUTPUT_DIR"] || "./build",
      output_name: "Where.ipa",
      destination: "generic/platform=iOS",
      skip_profile_detection: true,
      export_options: {
        method: "app-store",
        teamID: TEAM_ID,
        signingStyle: "manual",
        signingCertificate: "iPhone Distribution",
        uploadSymbols: true,
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )

    # Belt and braces: the "Upload Crashlytics dSYMs" build phase already uploads during the
    # archive, but that phase silently skips itself if anything is missing. Uploading the dSYM
    # gym just produced means an App Store build can never ship without symbols in Crashlytics.
    # Crashlytics dedupes by dSYM UUID, so a double upload is harmless.
    dsym_path = lane_context[SharedValues::DSYM_OUTPUT_PATH]
    gsp_path = "iosApp/Where/GoogleService-Info.plist"
    upload_symbols = File.join(
      derived_data, "SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols"
    )

    if dsym_path.nil? || !File.exist?(dsym_path)
      UI.important("No dSYM produced by gym; skipping Crashlytics upload")
    elsif !File.exist?(gsp_path)
      UI.important("#{gsp_path} missing; skipping Crashlytics upload")
    elsif !File.exist?(upload_symbols)
      UI.important("upload-symbols not found at #{upload_symbols}; skipping Crashlytics upload")
    else
      upload_symbols_to_crashlytics(
        dsym_path: dsym_path,
        gsp_path: gsp_path,
        binary_path: upload_symbols,
        platform: "ios"
      )
    end
  end

  lane :deploy do
    submit = ENV["SUBMIT_FOR_REVIEW"] != "false"
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )
    whats_new_en = ENV["WHATS_NEW_EN"] || "Bug fixes and improvements."
    whats_new_no = ENV["WHATS_NEW_NO"] || "Feilrettinger og forbedringer."

    options = {
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: ENV["IPA_PATH"],
      skip_screenshots: true,
      skip_metadata: !submit,
      force: true,
      submit_for_review: submit,
      automatic_release: submit,
      precheck_include_in_app_purchases: false,
      release_notes: { "en-US" => whats_new_en, "no" => whats_new_no }
    }

    # App Store Connect rejects the review submission unless the App Review contact
    # is set on the version. Phone must be +countrycode, e.g. +4712345678.
    contact_email = ENV["ASC_CONTACT_EMAIL"]
    if submit && contact_email && !contact_email.empty?
      options[:app_review_information] = {
        first_name: ENV["ASC_CONTACT_FIRST_NAME"],
        last_name: ENV["ASC_CONTACT_LAST_NAME"],
        phone_number: ENV["ASC_CONTACT_PHONE"],
        email_address: contact_email
      }
    end

    upload_to_app_store(options)
  end
end
